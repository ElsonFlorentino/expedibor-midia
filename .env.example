# Meta Business Manager — Expedibor
# ID do Business Manager (não é segredo, só identificador)
META_BUSINESS_MANAGER_ID=61593100654558

# Token de acesso (System User recomendado — nunca commitar o valor real).
# Gerar em: Business Manager > Configurações de negócios > Usuários do sistema
# > [criar/selecionar system user] > Gerar novo token > escopo: ads_management,
# ads_read, business_management, na conta de anúncio da Expedibor.
META_SYSTEM_USER_TOKEN=

# ID da conta de anúncio (formato act_XXXXXXXXXX) — diferente do BM ID acima
META_AD_ACCOUNT_ID=

# ID da Página do Facebook da Expedibor (necessário pra vincular os anúncios)
META_PAGE_ID=
